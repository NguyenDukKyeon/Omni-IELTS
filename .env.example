# Optional server-managed Gemini key. Leave empty to let each user provide a session-only key.
GEMINI_API_KEY=
# Server allowlist. When GEMINI_API_KEY is set, the server always uses GEMINI_MODEL.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-pro-preview
GEMINI_MODEL=gemini-3.6-flash

# Optional Web Push configuration.
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
