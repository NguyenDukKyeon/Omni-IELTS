    {
      "id": "lesson:sampler-listening-community-workshop",
      "schemaVersion": 2,
      "contentRevision": 1,
      "contentAddress": "sha256:7e563fd0155ec4d5a5fa1614f311ff618afd329e2d8969bd6ca11fa96769933b",
      "title": "Booking a Community Workshop",
      "learningObjective": "Identify a changed time, room and booking condition in a short community-centre call.",
      "estimatedMinutes": 10,
      "difficulty": "B1",
      "skill": "listening",
      "topic": "Community services",
      "lexicalTargets": [
        {
          "id": "lex:sampler-listening-community-workshop:1",
          "term": "reserve a place",
          "meaning": "secure a position before the event",
          "register": "neutral-academic",
          "usageNote": "Use “reserve a place” only with the meaning stated here."
        },
        {
          "id": "lex:sampler-listening-community-workshop:2",
          "term": "two places remain",
          "meaning": "two spaces are still available",
          "register": "neutral-academic",
          "usageNote": "Use “two places remain” only with the meaning stated here."
        },
        {
          "id": "lex:sampler-listening-community-workshop:3",
          "term": "has moved from",
          "meaning": "has changed location from",
          "register": "neutral-academic",
          "usageNote": "Use “has moved from” only with the meaning stated here."
        },
        {
          "id": "lex:sampler-listening-community-workshop:4",
          "term": "updated details",
          "meaning": "the latest corrected information",
          "register": "neutral-academic",
          "usageNote": "Use “updated details” only with the meaning stated here."
        }
      ],
      "assetIds": [
        "asset:sampler-listening-community-workshop:content",
        "asset:sampler-listening-community-workshop:audio"
      ],
      "activities": [
        {
          "id": "activity:sampler-listening-community-workshop:comprehension",
          "type": "listening-comprehension",
          "prompt": "Which detail changed in the recording?",
          "options": [
            {
              "label": "The detail stated in sentence three"
            },
            {
              "label": "A detail not mentioned in the recording"
            }
          ],
          "answer": {
            "text": "That session has moved from Room Four to the garden studio beside reception."
          },
          "feedback": "Use the exact changed detail rather than a plausible topic word.",
          "target": {
            "lessonId": "lesson:sampler-listening-community-workshop",
            "activityId": "activity:sampler-listening-community-workshop:comprehension",
            "contentRevision": 1
          },
          "assetIds": [
            "asset:sampler-listening-community-workshop:content",
            "asset:sampler-listening-community-workshop:audio"
          ]
        },
        {
          "id": "activity:sampler-listening-community-workshop:dictation",
          "type": "dictation",
          "prompt": "Write the second sentence exactly as you hear it.",
          "answer": {
            "text": "The morning group is full, but two places remain in the session at half past two."
          },
          "feedback": "Check content words, function words and the stated detail.",
          "target": {
            "lessonId": "lesson:sampler-listening-community-workshop",
            "activityId": "activity:sampler-listening-community-workshop:dictation",
            "contentRevision": 1
          },
          "assetIds": [
            "asset:sampler-listening-community-workshop:content",
            "asset:sampler-listening-community-workshop:audio"
          ]
        },
        {
          "id": "activity:sampler-listening-community-workshop:strict",
          "type": "strict-practice",
          "prompt": "Retrieve the fourth sentence without opening the transcript.",
          "answer": {
            "text": "Please arrive ten minutes early and bring a reusable water bottle."
          },
          "feedback": "Opening the answer makes this attempt coaching-only.",
          "target": {
            "lessonId": "lesson:sampler-listening-community-workshop",
            "activityId": "activity:sampler-listening-community-workshop:strict",
            "contentRevision": 1
          },
          "assetIds": [
            "asset:sampler-listening-community-workshop:content",
            "asset:sampler-listening-community-workshop:audio"
          ]
        },
        {
          "id": "activity:sampler-listening-community-workshop:shadowing",
          "type": "shadowing",
          "prompt": "Shadow the final two sentences with thought-group pauses.",
          "answer": {
            "text": "Please arrive ten minutes early and bring a reusable water bottle. I will reserve one place and send the updated details by email."
          },
          "feedback": "Aim for rhythm and intelligibility; this is coaching, not independent evidence.",
          "target": {
            "lessonId": "lesson:sampler-listening-community-workshop",
            "activityId": "activity:sampler-listening-community-workshop:shadowing",
            "contentRevision": 1
          },
          "assetIds": [
            "asset:sampler-listening-community-workshop:content",
            "asset:sampler-listening-community-workshop:audio"
          ]
        },
        {
          "id": "activity:sampler-listening-community-workshop:retell",
          "type": "retell-coaching",
          "prompt": "Retell the practical outcome in two sentences.",
          "answer": {
            "text": "Mention the main change and the required action, using reserve a place where suitable."
          },
          "feedback": "Retell remains coaching-only without an independent evaluator.",
