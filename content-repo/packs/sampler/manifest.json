      "id": "lesson:sampler-reading-public-benches",
      "schemaVersion": 2,
      "contentRevision": 1,
      "contentAddress": "sha256:1ffe687e8285fd9db5f99bb2adc797ff3cab17f8182450a1f56ac2647c496d12",
      "title": "Why Public Benches Matter",
      "learningObjective": "Recognise a main claim, supporting detail and plausible distractor in a short urban-design passage.",
      "estimatedMinutes": 12,
      "difficulty": "B2",
      "skill": "reading",
      "topic": "Inclusive cities",
      "lexicalTargets": [
        {
          "id": "lex:sampler-reading-public-benches:1",
          "term": "street furniture",
          "meaning": "objects installed in public streets for shared use",
          "register": "neutral-academic",
          "usageNote": "Use “street furniture” only with the meaning stated here."
        },
        {
          "id": "lex:sampler-reading-public-benches:2",
          "term": "limited mobility",
          "meaning": "reduced ability to move easily",
          "register": "neutral-academic",
          "usageNote": "Use “limited mobility” only with the meaning stated here."
        },
        {
          "id": "lex:sampler-reading-public-benches:3",
          "term": "travel independently",
          "meaning": "make a journey without assistance",
          "register": "neutral-academic",
          "usageNote": "Use “travel independently” only with the meaning stated here."
        },
        {
          "id": "lex:sampler-reading-public-benches:4",
          "term": "balanced approach",
          "meaning": "a response that considers competing needs",
          "register": "neutral-academic",
          "usageNote": "Use “balanced approach” only with the meaning stated here."
        }
      ],
      "assetIds": [
        "asset:sampler-reading-public-benches:content"
      ],
      "activities": [
        {
          "id": "activity:sampler-reading-public-benches:main-claim",
          "type": "reading-comprehension",
          "prompt": "State the passage’s central claim in one sentence.",
          "answer": {
            "text": "Recognise a main claim, supporting detail and plausible distractor in a short urban-design passage."
          },
          "feedback": "A strong answer preserves the scope of the passage.",
          "target": {
            "lessonId": "lesson:sampler-reading-public-benches",
            "activityId": "activity:sampler-reading-public-benches:main-claim",
            "contentRevision": 1
          },
          "assetIds": [
            "asset:sampler-reading-public-benches:content"
          ]
        },
        {
          "id": "activity:sampler-reading-public-benches:paraphrase",
          "type": "paraphrase-recognition",
          "prompt": "Which expression best preserves “street furniture”?",
          "options": [
            {
              "label": "objects installed in public streets for shared use"
            },
            {
              "label": "an unrelated general improvement"
            }
          ],
          "answer": {
            "text": "objects installed in public streets for shared use"
          },
          "feedback": "Match meaning and claim strength, not just topic.",
          "target": {
            "lessonId": "lesson:sampler-reading-public-benches",
            "activityId": "activity:sampler-reading-public-benches:paraphrase",
            "contentRevision": 1
          },
          "assetIds": [
            "asset:sampler-reading-public-benches:content"
          ]
        },
        {
          "id": "activity:sampler-reading-public-benches:distractor",
          "type": "distractor-recognition",
          "prompt": "Identify a plausible statement that the passage does not establish.",
          "answer": {
            "text": "A broad universal claim that removes the passage’s stated limitation."
          },
          "feedback": "Distractors often repeat vocabulary while changing scope or causality.",
          "target": {
            "lessonId": "lesson:sampler-reading-public-benches",
            "activityId": "activity:sampler-reading-public-benches:distractor",
            "contentRevision": 1
          },
          "assetIds": [
            "asset:sampler-reading-public-benches:content"
          ]
        },
        {
          "id": "activity:sampler-reading-public-benches:micro-reading",
          "type": "micro-reading",
          "prompt": "Find the sentence that limits the main claim and explain its function.",
          "answer": {
            "text": "The limiting sentence prevents the evidence from supporting a broader conclusion."
          },
          "feedback": "Look for contrast markers and cautious reporting verbs.",
          "target": {
            "lessonId": "lesson:sampler-reading-public-benches",
            "activityId": "activity:sampler-reading-public-benches:micro-reading",
            "contentRevision": 1
          },
