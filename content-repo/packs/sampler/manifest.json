          "type": "paragraph-production",
          "prompt": "Write 70–90 words using “limited mobility” to evaluate the passage.",
          "answer": {
            "text": "A complete paragraph should state a claim, cite a passage detail and preserve one limitation."
          },
          "feedback": "This follow-up is coaching-only until independently evaluated.",
          "target": {
