        "startMs": 5500,
        "endMs": 10750,
        "text": "Buses will not stop outside the central market for approximately ten days."
      },
      {
        "id": "segment:foundations-w2-listening-transport-change:3",
        "startMs": 11000,
        "endMs": 16250,
        "text": "Use the temporary stop on King Street beside the post office."
      },
      {
