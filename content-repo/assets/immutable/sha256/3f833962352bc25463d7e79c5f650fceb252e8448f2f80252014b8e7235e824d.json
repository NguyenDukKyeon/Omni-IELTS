        "startMs": 16500,
        "endMs": 21750,
        "text": "Passengers for the hospital may find Route Twelve more direct during the works."
      },
      {
        "id": "segment:foundations-w2-listening-transport-change:5",
        "startMs": 22000,
        "endMs": 27250,
        "text": "Normal service is expected to resume on the eighteenth of August."
